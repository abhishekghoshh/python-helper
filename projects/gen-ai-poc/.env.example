# GenAI POC — Environment Configuration
# Copy to .env and fill in your values

# --- LLM Configuration ---
# Free/local LLM options (no OpenAI key needed):
#   Ollama:      Install from https://ollama.ai, then run e.g. `ollama run llama3`
#                Set LLM_BASE_URL=http://host.docker.internal:11434/v1 (Docker on Mac)
#                or http://localhost:11434/v1 (local). Use any non-empty LLM_API_KEY.
#   LM Studio:   Install from https://lmstudio.ai, enable "Server" mode.
#                Set LLM_BASE_URL=http://host.docker.internal:1234/v1
#   Hugging Face: Set LLM_PROVIDER=openai and use a free HF Inference API endpoint.
LLM_PROVIDER=openai
LLM_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TOP_P=1.0
LLM_TIMEOUT=30

# --- Embedding Configuration ---
# "sentence-transformers" = local model (no API key needed)
# "openai" = uses OpenAI embedding API
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# --- Vector Database ---
QDRANT_HOST=http://localhost:6333
QDRANT_COLLECTION=genai-documents
QDRANT_DISTANCE=cosine

# --- RAG Configuration ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# --- Application ---
APP_NAME=GenAI POC
APP_VERSION=0.1.0
DEBUG=false

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# One of: "standard" (human-readable) or "json" (structured)
LOG_FORMAT=standard
# Optional: file path for log output (defaults to stdout only)
# LOG_FILE=/var/log/genai-poc/app.log
