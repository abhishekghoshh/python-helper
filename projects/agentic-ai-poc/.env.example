# ------------------------------------------------------------------
# Agentic AI POC — Environment Configuration
# Copy this file to .env and adjust as needed.
# ------------------------------------------------------------------

# --- LLM Provider ---
# "openai" for OpenAI API, "openai-compatible" for a local/Ollama-style endpoint
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_TOP_P=1.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# --- Agent Settings ---
# Maximum agent loop iterations before forced termination
AGENT_MAX_ITERATIONS=10
# Delay (seconds) between agent loop iterations (for rate limiting)
AGENT_ITERATION_DELAY=0.0
# Enable reasoning trace logging
AGENT_TRACE_ENABLED=true
# Simulated mode uses a Mock LLM (no API key needed) — useful for demos and tests
AGENT_SIMULATED_MODE=true

# --- Memory Settings ---
# Max characters of conversation history to retain
MEMORY_MAX_HISTORY_CHARS=8000
# Long-term memory storage file (relative to project root)
MEMORY_LT_DB_PATH=data/memory.db

# --- Embedding / RAG Settings ---
# Embedding backend: "sentence-transformers" (local) or "openai" (cloud)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=agentic-docs
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# --- Human-in-the-Loop ---
# When true, the agent requests human approval before executing tools
HITL_ENABLED=false
# Tools that always require approval regardless of global setting
HITL_REQUIRED_TOOLS=execute_command,write_file

# --- Security / Guardrails ---
# Maximum tokens per LLM request
LLM_MAX_OUTPUT_TOKENS=4096
# Tools the agent is allowed to call (comma-separated, or "all" for unrestricted)
TOOL_ALLOW_LIST=calculator,datetime_now,file_reader,web_search,rag_query
# Request timeout for tool execution (seconds)
TOOL_TIMEOUT_SECONDS=30